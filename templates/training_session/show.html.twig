{% extends 'base.html.twig' %}

{% block title %}Détail de l'entraînement{% endblock %}

{% block body %}
    <h1>Détail de l'entraînement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Équipe</th>
                <td>
                    {% if training_session.team %}
                        <a href="{{ path('app_team_show', { id: training_session.team.id }) }}">
                            {{ training_session.team.name }}
                        </a>
                    {% else %}
                        Équipe inconnue
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>Date</th>
                <td>{{ training_session.trainingDate ? training_session.trainingDate|date('d/m/Y') : '-' }}</td>
            </tr>

            <tr>
                <th>Horaires</th>
                <td>{{ training_session.timeRangeLabel }}</td>
            </tr>

            <tr>
                <th>Durée</th>
                <td>{{ training_session.durationLabel }}</td>
            </tr>

            <tr>
                <th>Lieu</th>
                <td>{{ training_session.location }}</td>
            </tr>

            <tr>
                <th>Thème</th>
                <td>{{ training_session.theme ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Commentaire</th>
                <td>{{ training_session.comment ?: 'Aucun commentaire' }}</td>
            </tr>

            <tr>
                <th>Présences renseignées</th>
                <td>
                    {{ training_session.attendancesCount }}
                    dont {{ training_session.presentAttendancesCount }} présent(s)
                </td>
            </tr>
        </tbody>
    </table>

    <h2>Présences</h2>

    <p>
        <a href="{{ path('app_training_attendance_manage_session', { id: training_session.id }) }}">
            Gérer la feuille de présence
        </a>
    </p>

    {% if training_session.attendances|length > 0 %}
        <table class="table">
            <thead>
                <tr>
                    <th>Joueur</th>
                    <th>Statut</th>
                    <th>Commentaire</th>
                    <th>Modifié par</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for attendance in training_session.attendances %}
                    <tr>
                        <td>
                            {% if attendance.player %}
                                <a href="{{ path('app_player_show', { id: attendance.player.id }) }}">
                                    {{ attendance.player.fullName }}
                                </a>
                            {% else %}
                                Joueur inconnu
                            {% endif %}
                        </td>

                        <td>{{ attendance.statusLabel }}</td>

                        <td>{{ attendance.comment ?: '-' }}</td>

                        <td>
                            {{ attendance.updatedBy ? attendance.updatedBy.fullName : 'Non renseigné' }}
                        </td>

                        <td>
                            <a href="{{ path('app_training_attendance_show', { id: attendance.id }) }}">Voir</a>
                            <a href="{{ path('app_training_attendance_edit', { id: attendance.id }) }}">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucune présence renseignée pour cet entraînement.</p>
    {% endif %}

    <a href="{{ path('app_training_session_index') }}">Retour à la liste</a>

    {% if training_session.team %}
        <a href="{{ path('app_team_show', { id: training_session.team.id }) }}">Retour à l'équipe</a>
    {% endif %}

    <a href="{{ path('app_training_session_edit', { id: training_session.id }) }}">Modifier</a>

    {% if training_session.attendances|length > 0 %}
        <div class="alert alert-warning">
            <p>
                Cet entraînement possède déjà des présences renseignées.
                Il ne peut pas être supprimé directement.
            </p>

            <p>
                Supprime d'abord les présences liées avant de supprimer cet entraînement.
            </p>
        </div>
    {% else %}
        {{ include('training_session/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}