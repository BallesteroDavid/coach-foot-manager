{% extends 'base.html.twig' %}

{% block title %}Entraînements{% endblock %}

{% block body %}
    <h1>Liste des entraînements</h1>

    <a href="{{ path('app_training_session_new') }}">Créer un entraînement</a>

    {% if training_sessions is empty %}
        <p>Aucun entraînement enregistré.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Équipe</th>
                    <th>Horaires</th>
                    <th>Durée</th>
                    <th>Lieu</th>
                    <th>Thème</th>
                    <th>Créé par</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for training_session in training_sessions %}
                    <tr>
                        <td>
                            {{ training_session.trainingDate ? training_session.trainingDate|date('d/m/Y') : '-' }}
                        </td>

                        <td>
                            {% if training_session.team %}
                                <a href="{{ path('app_team_show', { id: training_session.team.id }) }}">
                                    {{ training_session.team.name }}
                                </a>
                            {% else %}
                                Équipe inconnue
                            {% endif %}
                        </td>

                        <td>{{ training_session.timeRangeLabel }}</td>

                        <td>{{ training_session.durationLabel }}</td>

                        <td>{{ training_session.location }}</td>

                        <td>{{ training_session.theme ?: 'Non renseigné' }}</td>

                        <td>
                            {{ training_session.createdBy ? training_session.createdBy.fullName : 'Non renseigné' }}
                        </td>

                        <td>
                            <a href="{{ path('app_training_session_show', { id: training_session.id }) }}">Voir</a>
                            <a href="{{ path('app_training_session_edit', { id: training_session.id }) }}">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}