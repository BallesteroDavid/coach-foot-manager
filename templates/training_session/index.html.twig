{% extends 'base.html.twig' %}

{% block title %}Entraînements{% endblock %}

{% block body %}
    <div class="page-container">

        <div class="page-header">
            <div>
                <h1 class="page-title">Entraînements</h1>
                <p class="page-subtitle">
                    Liste des séances d'entraînement auxquelles tu as accès.
                </p>
            </div>

            <div class="top-actions">
                {% if is_granted('ROLE_COACH') %}
                    <a href="{{ path('app_training_session_new') }}" class="btn btn-primary">
                        Créer un entraînement
                    </a>
                {% endif %}
            </div>
        </div>

        {% if training_sessions is empty %}
            <div class="empty-state">
                <strong>Aucun entraînement enregistré.</strong>
                <p>
                    Tu peux créer une première séance pour une équipe.
                </p>
            </div>
        {% else %}
            <div class="card">
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Équipe</th>
                                <th>Horaires</th>
                                <th>Durée</th>
                                <th>Lieu</th>
                                <th>Thème</th>
                                <th>Créé par</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for training_session in training_sessions %}
                                <tr>
                                    <td>
                                        <strong>
                                            {{ training_session.trainingDate ? training_session.trainingDate|date('d/m/Y') : '-' }}
                                        </strong>
                                    </td>

                                    <td>
                                        {% if training_session.team %}
                                            <a href="{{ path('app_team_show', { id: training_session.team.id }) }}" class="badge">
                                                {{ training_session.team.name }}
                                            </a>
                                        {% else %}
                                            <span class="badge badge-muted">Équipe inconnue</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {{ training_session.timeRangeLabel }}
                                    </td>

                                    <td>
                                        {{ training_session.durationLabel }}
                                    </td>

                                    <td>
                                        {{ training_session.location ?: 'Non renseigné' }}
                                    </td>

                                    <td>
                                        {{ training_session.theme ?: 'Non renseigné' }}
                                    </td>

                                    <td>
                                        {{ training_session.createdBy ? training_session.createdBy.fullName : 'Non renseigné' }}
                                    </td>

                                    <td>
                                        <div class="actions">
                                            <a href="{{ path('app_training_session_show', { id: training_session.id }) }}" class="btn btn-secondary">
                                                Voir
                                            </a>

                                            {% if is_granted('ROLE_COACH') %}
                                                <a href="{{ path('app_training_session_edit', { id: training_session.id }) }}" class="btn btn-primary">
                                                    Modifier
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}