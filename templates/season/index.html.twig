{% extends 'base.html.twig' %}

{% block title %}Saisons{% endblock %}

{% block body %}
    <div class="page-container">

        <div class="page-header">
            <div>
                <h1 class="page-title">Saisons</h1>
                <p class="page-subtitle">
                    Gestion des saisons sportives du club.
                </p>
            </div>

            <div class="top-actions">
                <a href="{{ path('app_season_new') }}" class="btn btn-primary">
                    Créer une saison
                </a>
            </div>
        </div>

        {% set statusLabels = {
            planned: 'Planifiée',
            active: 'Active',
            closed: 'Clôturée'
        } %}

        {% set statusClasses = {
            planned: 'badge-warning',
            active: 'badge-success',
            closed: 'badge-muted'
        } %}

        {% if seasons is empty %}
            <div class="empty-state">
                <strong>Aucune saison enregistrée.</strong>
                <p>
                    Crée une première saison pour organiser les équipes et les compétitions.
                </p>
            </div>
        {% else %}
            <div class="card">
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Club</th>
                                <th>Période</th>
                                <th>Statut</th>
                                <th>Équipes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for season in seasons %}
                                <tr>
                                    <td>
                                        <strong>{{ season.name }}</strong>
                                    </td>

                                    <td>
                                        {% if season.club %}
                                            {{ season.club.name }}
                                        {% else %}
                                            <span class="badge badge-muted">Aucun club</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {{ season.periodLabel }}
                                    </td>

                                    <td>
                                        <span class="badge {{ statusClasses[season.status]|default('badge-muted') }}">
                                            {{ statusLabels[season.status]|default(season.status ?: 'Non renseigné') }}
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge badge-success">
                                            {{ season.teamsCount }} équipe{{ season.teamsCount > 1 ? 's' : '' }}
                                        </span>
                                    </td>

                                    <td>
                                        <div class="actions">
                                            <a href="{{ path('app_season_show', { id: season.id }) }}" class="btn btn-secondary">
                                                Voir
                                            </a>

                                            <a href="{{ path('app_season_edit', { id: season.id }) }}" class="btn btn-primary">
                                                Modifier
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}