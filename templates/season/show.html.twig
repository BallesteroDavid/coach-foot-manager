{% extends 'base.html.twig' %}

{% block title %}{{ season.name }}{% endblock %}

{% block body %}
    <div class="page-container">

        {% set statusLabels = {
            planned: 'Planifiée',
            active: 'Active',
            closed: 'Clôturée'
        } %}

        {% set statusClasses = {
            planned: 'badge-warning',
            active: 'badge-success',
            closed: 'badge-muted'
        } %}

        <div class="page-header">
            <div>
                <h1 class="page-title">{{ season.name }}</h1>
                <p class="page-subtitle">
                    Détail de la saison sportive.
                </p>
            </div>

            <div class="top-actions">
                <a href="{{ path('app_season_index') }}" class="btn btn-secondary">
                    Retour à la liste
                </a>

                <a href="{{ path('app_season_edit', { id: season.id }) }}" class="btn btn-primary">
                    Modifier
                </a>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Informations de la saison</h2>

            <div class="table-wrapper">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>Nom</th>
                            <td>
                                <strong>{{ season.name }}</strong>
                            </td>
                        </tr>

                        <tr>
                            <th>Club</th>
                            <td>
                                {% if season.club %}
                                    {{ season.club.name }}
                                {% else %}
                                    <span class="badge badge-muted">Aucun club</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Période</th>
                            <td>{{ season.periodLabel }}</td>
                        </tr>

                        <tr>
                            <th>Date de début</th>
                            <td>{{ season.startDate ? season.startDate|date('d/m/Y') : '-' }}</td>
                        </tr>

                        <tr>
                            <th>Date de fin</th>
                            <td>{{ season.endDate ? season.endDate|date('d/m/Y') : '-' }}</td>
                        </tr>

                        <tr>
                            <th>Statut</th>
                            <td>
                                <span class="badge {{ statusClasses[season.status]|default('badge-muted') }}">
                                    {{ statusLabels[season.status]|default(season.status ?: 'Non renseigné') }}
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Nombre d’équipes</th>
                            <td>
                                <span class="badge badge-success">
                                    {{ season.teamsCount }} équipe{{ season.teamsCount > 1 ? 's' : '' }}
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Créée le</th>
                            <td>{{ season.createdAt ? season.createdAt|date('d/m/Y H:i') : '-' }}</td>
                        </tr>

                        <tr>
                            <th>Modifiée le</th>
                            <td>{{ season.updatedAt ? season.updatedAt|date('d/m/Y H:i') : '-' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {% if season.teams|length > 0 %}
            <section class="dashboard-section">
                <div class="section-title">
                    <h2>Équipes associées</h2>
                    <p>Les équipes rattachées à cette saison.</p>
                </div>

                <div class="card">
                    <div class="table-wrapper">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Équipe</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for team in season.teams %}
                                    <tr>
                                        <td>
                                            <strong>{{ team.name }}</strong>
                                        </td>

                                        <td>
                                            <a href="{{ path('app_team_show', { id: team.id }) }}" class="btn btn-secondary">
                                                Voir
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        {% endif %}

        <section class="dashboard-section">
            <div class="section-title">
                <h2>Suppression</h2>
                <p>Suppression possible uniquement si aucune équipe n’est associée.</p>
            </div>

            {% if season.teamsCount > 0 %}
                <div class="alert alert-warning">
                    <p>
                        Cette saison possède déjà une ou plusieurs équipes associées.
                        Elle ne peut pas être supprimée directement.
                    </p>

                    <p>
                        Retire d'abord les équipes de cette saison avant de la supprimer.
                    </p>
                </div>
            {% else %}
                {{ include('season/_delete_form.html.twig') }}
            {% endif %}
        </section>

    </div>
{% endblock %}