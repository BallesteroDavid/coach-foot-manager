{% extends 'base.html.twig' %}

{% block title %}Détail de la saison{% endblock %}

{% block body %}
    <h1>Détail de la saison</h1>

    {% set statusLabels = {
        planned: 'Planifiée',
        active: 'Active',
        closed: 'Clôturée'
    } %}

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ season.name }}</td>
            </tr>

            <tr>
                <th>Club</th>
                <td>{{ season.club ? season.club.name : 'Aucun club' }}</td>
            </tr>

            <tr>
                <th>Période</th>
                <td>{{ season.periodLabel }}</td>
            </tr>

            <tr>
                <th>Date de début</th>
                <td>{{ season.startDate ? season.startDate|date('d/m/Y') : '-' }}</td>
            </tr>

            <tr>
                <th>Date de fin</th>
                <td>{{ season.endDate ? season.endDate|date('d/m/Y') : '-' }}</td>
            </tr>

            <tr>
                <th>Statut</th>
                <td>{{ statusLabels[season.status]|default(season.status) }}</td>
            </tr>

            <tr>
                <th>Nombre d’équipes</th>
                <td>{{ season.teamsCount }}</td>
            </tr>

            <tr>
                <th>Créée le</th>
                <td>{{ season.createdAt ? season.createdAt|date('d/m/Y H:i') : '-' }}</td>
            </tr>

            <tr>
                <th>Modifiée le</th>
                <td>{{ season.updatedAt ? season.updatedAt|date('d/m/Y H:i') : '-' }}</td>
            </tr>
        </tbody>
    </table>

    {% if season.teams|length > 0 %}
        <h2>Équipes associées</h2>

        <ul>
            {% for team in season.teams %}
                <li>
                    <a href="{{ path('app_team_show', { id: team.id }) }}">
                        {{ team.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <a href="{{ path('app_season_index') }}">Retour à la liste</a>
    <a href="{{ path('app_season_edit', { id: season.id }) }}">Modifier</a>

    {% if season.teamsCount > 0 %}
        <div class="alert alert-warning">
            <p>
                Cette saison possède déjà une ou plusieurs équipes associées.
                Elle ne peut pas être supprimée directement.
            </p>

            <p>
                Retire d'abord les équipes de cette saison avant de la supprimer.
            </p>
        </div>
    {% else %}
        {{ include('season/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}