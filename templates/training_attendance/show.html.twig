{% extends 'base.html.twig' %}

{% block title %}Détail de la présence{% endblock %}

{% block body %}
    <div class="page-container">

        {% set statusClasses = {
            present: 'badge-success',
            absent: 'badge-danger',
            excused: 'badge-warning',
            late: 'badge-warning',
            injured: 'badge-danger',
            exempt: 'badge-muted'
        } %}

        <div class="page-header">
            <div>
                <h1 class="page-title">Détail de la présence</h1>
                <p class="page-subtitle">
                    Statut de présence d’un joueur à un entraînement.
                </p>
            </div>

            <div class="top-actions">
                <a href="{{ path('app_training_attendance_index') }}" class="btn btn-secondary">
                    Retour à la liste
                </a>

                {% if training_attendance.trainingSession %}
                    <a href="{{ path('app_training_session_show', { id: training_attendance.trainingSession.id }) }}" class="btn btn-secondary">
                        Retour à l'entraînement
                    </a>
                {% endif %}

                {% if is_granted('ROLE_COACH') %}
                    <a href="{{ path('app_training_attendance_edit', { id: training_attendance.id }) }}" class="btn btn-primary">
                        Modifier
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Informations de présence</h2>

            <div class="table-wrapper">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>Entraînement</th>
                            <td>
                                {% if training_attendance.trainingSession %}
                                    <strong>
                                        {{ training_attendance.trainingSession.trainingDate ? training_attendance.trainingSession.trainingDate|date('d/m/Y') : '-' }}
                                    </strong>
                                    —
                                    {{ training_attendance.trainingSession.team ? training_attendance.trainingSession.team.name : 'Équipe inconnue' }}
                                    —
                                    {{ training_attendance.trainingSession.timeRangeLabel }}
                                {% else %}
                                    <span class="badge badge-muted">Entraînement inconnu</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Joueur</th>
                            <td>
                                {% if training_attendance.player %}
                                    <a href="{{ path('app_player_show', { id: training_attendance.player.id }) }}">
                                        <strong>{{ training_attendance.player.fullName }}</strong>
                                    </a>
                                {% else %}
                                    <span class="badge badge-muted">Joueur inconnu</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Statut</th>
                            <td>
                                <span class="badge {{ statusClasses[training_attendance.status]|default('badge-muted') }}">
                                    {{ training_attendance.statusLabel }}
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Commentaire</th>
                            <td>
                                {{ training_attendance.comment ?: 'Aucun commentaire' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Modifié par</th>
                            <td>
                                {{ training_attendance.updatedBy ? training_attendance.updatedBy.fullName : 'Non renseigné' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Créée le</th>
                            <td>
                                {{ training_attendance.createdAt ? training_attendance.createdAt|date('d/m/Y H:i') : '-' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Modifiée le</th>
                            <td>
                                {{ training_attendance.updatedAt ? training_attendance.updatedAt|date('d/m/Y H:i') : '-' }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {% if is_granted('ROLE_COACH') %}
            <section class="dashboard-section">
                <div class="section-title">
                    <h2>Suppression</h2>
                    <p>Supprimer cette présence si elle a été saisie par erreur.</p>
                </div>

                {{ include('training_attendance/_delete_form.html.twig') }}
            </section>
        {% endif %}

    </div>
{% endblock %}