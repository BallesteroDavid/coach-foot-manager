{% extends 'base.html.twig' %}

{% block title %}Fiche joueur{% endblock %}

{% block body %}
    <h1>Fiche joueur</h1>

    {% set positionLabels = {
        gardien: 'Gardien',
        defenseur: 'Défenseur',
        milieu: 'Milieu',
        attaquant: 'Attaquant'
    } %}

    {% set statusLabels = {
        active: 'Actif',
        injured: 'Blessé',
        suspended: 'Suspendu',
        inactive: 'Inactif'
    } %}

    <table class="table">
        <tbody>
            <tr>
                <th>Nom complet</th>
                <td>{{ player.fullName }}</td>
            </tr>

            <tr>
                <th>Prénom</th>
                <td>{{ player.firstName }}</td>
            </tr>

            <tr>
                <th>Nom</th>
                <td>{{ player.lastName }}</td>
            </tr>

            <tr>
                <th>Date de naissance</th>
                <td>
                    {{ player.birthDate ? player.birthDate|date('d/m/Y') : 'Non renseignée' }}
                </td>
            </tr>

            <tr>
                <th>Email du joueur</th>
                <td>{{ player.email ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Téléphone du joueur</th>
                <td>{{ player.phone ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Email du parent / responsable légal</th>
                <td>{{ player.guardianEmail ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Téléphone du parent / responsable légal</th>
                <td>{{ player.guardianPhone ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Poste</th>
                <td>{{ positionLabels[player.position]|default(player.position ?: 'Non renseigné') }}</td>
            </tr>

            <tr>
                <th>Numéro de maillot</th>
                <td>{{ player.jerseyNumber ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Statut</th>
                <td>{{ statusLabels[player.status]|default(player.status) }}</td>
            </tr>

            <tr>
                <th>Équipe</th>
                <td>{{ player.team ? player.team.name : 'Aucune équipe' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_player_index') }}">Retour à la liste</a>
    <a href="{{ path('app_player_edit', { id: player.id }) }}">Modifier</a>

    {{ include('player/_delete_form.html.twig') }}
{% endblock %}