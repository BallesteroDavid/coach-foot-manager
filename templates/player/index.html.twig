{% extends 'base.html.twig' %}

{% block title %}Joueurs{% endblock %}

{% block body %}
    <h1>Liste des joueurs</h1>

    <a href="{{ path('app_player_new') }}">Ajouter un joueur</a>

    {% if players is empty %}
        <p>Aucun joueur enregistré.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Équipe</th>
                    <th>Poste</th>
                    <th>N°</th>
                    <th>Email joueur</th>
                    <th>Téléphone joueur</th>
                    <th>Email responsable</th>
                    <th>Téléphone responsable</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for player in players %}
                    <tr>
                        <td>{{ player.firstName }} {{ player.lastName }}</td>

                        <td>
                            {{ player.team ? player.team.name : 'Aucune équipe' }}
                        </td>

                        <td>
                            {{ player.position ?: 'Non renseigné' }}
                        </td>

                        <td>
                            {{ player.jerseyNumber ?: '-' }}
                        </td>

                        <td>
                            {{ player.email ?: '-' }}
                        </td>

                        <td>
                            {{ player.phone ?: '-' }}
                        </td>

                        <td>
                            {{ player.guardianEmail ?: '-' }}
                        </td>

                        <td>
                            {{ player.guardianPhone ?: '-' }}
                        </td>

                        <td>
                            {{ player.status }}
                        </td>

                        <td>
                            <a href="{{ path('app_player_show', { id: player.id }) }}">Voir</a>
                            <a href="{{ path('app_player_edit', { id: player.id }) }}">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}