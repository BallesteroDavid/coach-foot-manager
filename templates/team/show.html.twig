{% extends 'base.html.twig' %}

{% block title %}Détail de l'équipe{% endblock %}

{% block body %}
    <h1>Détail de l'équipe</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ team.name }}</td>
            </tr>

            <tr>
                <th>Club</th>
                <td>{{ team.club ? team.club.name : 'Aucun club' }}</td>
            </tr>

            <tr>
                <th>Catégorie</th>
                <td>{{ team.category ? team.category.name : 'Aucune catégorie' }}</td>
            </tr>

            <tr>
                <th>Saison</th>
                <td>
                    {% if team.season %}
                        {{ team.season.name }} — {{ team.season.periodLabel }}
                    {% else %}
                        Aucune saison
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>Coachs</th>
                <td>
                    {% if team.coaches|length > 0 %}
                        <ul>
                            {% for coach in team.coaches %}
                                <li>
                                    <a href="{{ path('app_user_show', { id: coach.id }) }}">
                                        {{ coach.fullName }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        Aucun coach associé
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>Description</th>
                <td>{{ team.description ?: 'Non renseignée' }}</td>
            </tr>

            <tr>
                <th>Nombre de joueurs</th>
                <td>{{ team.playersCount }}</td>
            </tr>

            <tr>
                <th>Nombre de matchs</th>
                <td>{{ team.footballMatchesCount }}</td>
            </tr>

            <tr>
                <th>Nombre d'entraînements</th>
                <td>{{ team.trainingSessions|length }}</td>
            </tr>

            <tr>
                <th>Créée le</th>
                <td>{{ team.createdAt ? team.createdAt|date('d/m/Y H:i') : '-' }}</td>
            </tr>

            <tr>
                <th>Modifiée le</th>
                <td>{{ team.updatedAt ? team.updatedAt|date('d/m/Y H:i') : '-' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Entraînements</h2>

    <p>
        <a href="{{ path('app_training_session_new_from_team', { id: team.id }) }}">
            Créer un entraînement pour cette équipe
        </a>
    </p>

    {% if team.trainingSessions|length > 0 %}
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Horaires</th>
                    <th>Durée</th>
                    <th>Lieu</th>
                    <th>Thème</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for training_session in team.trainingSessions %}
                    <tr>
                        <td>
                            {{ training_session.trainingDate ? training_session.trainingDate|date('d/m/Y') : '-' }}
                        </td>

                        <td>{{ training_session.timeRangeLabel }}</td>

                        <td>{{ training_session.durationLabel }}</td>

                        <td>{{ training_session.location }}</td>

                        <td>{{ training_session.theme ?: 'Non renseigné' }}</td>

                        <td>
                            <a href="{{ path('app_training_session_show', { id: training_session.id }) }}">Voir</a>
                            <a href="{{ path('app_training_session_edit', { id: training_session.id }) }}">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun entraînement enregistré pour cette équipe.</p>
    {% endif %}

    <a href="{{ path('app_team_index') }}">Retour à la liste</a>
    <a href="{{ path('app_team_edit', { id: team.id }) }}">Modifier</a>

    {% if team.playersCount > 0 or team.footballMatchesCount > 0 or team.trainingSessions|length > 0 %}
        <div class="alert alert-warning">
            <p>
                Cette équipe possède déjà des joueurs, des matchs ou des entraînements associés.
                Elle ne peut pas être supprimée directement.
            </p>

            <p>
                Retire d'abord les joueurs, les matchs et les entraînements liés avant de supprimer cette équipe.
            </p>
        </div>
    {% else %}
        {{ include('team/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}