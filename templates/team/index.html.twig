{% extends 'base.html.twig' %}

{% block title %}Équipes{% endblock %}

{% block body %}
    <h1>Liste des équipes</h1>

    <a href="{{ path('app_team_new') }}">Créer une équipe</a>

    {% if teams is empty %}
        <p>Aucune équipe enregistrée.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Club</th>
                    <th>Catégorie</th>
                    <th>Saison</th>
                    <th>Coachs</th>
                    <th>Description</th>
                    <th>Joueurs</th>
                    <th>Matchs</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for team in teams %}
                    <tr>
                        <td>{{ team.name }}</td>

                        <td>
                            {{ team.club ? team.club.name : 'Aucun club' }}
                        </td>

                        <td>
                            {{ team.category ? team.category.name : 'Aucune catégorie' }}
                        </td>

                        <td>
                            {{ team.season ? team.season.name : 'Aucune saison' }}
                        </td>

                        <td>
                            {% if team.coaches|length > 0 %}
                                {% for coach in team.coaches %}
                                    {{ coach.fullName }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            {% else %}
                                Aucun coach
                            {% endif %}
                        </td>

                        <td>
                            {{ team.description ?: 'Non renseignée' }}
                        </td>

                        <td>
                            {{ team.playersCount }}
                        </td>

                        <td>
                            {{ team.footballMatchesCount }}
                        </td>

                        <td>
                            <a href="{{ path('app_team_show', { id: team.id }) }}">Voir</a>
                            <a href="{{ path('app_team_edit', { id: team.id }) }}">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}