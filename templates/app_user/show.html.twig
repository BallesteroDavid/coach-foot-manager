{% extends 'base.html.twig' %}

{% block title %}Détail de l'utilisateur{% endblock %}

{% block body %}
    <h1>Détail de l'utilisateur</h1>

    {% set roleLabels = {
        ROLE_USER: 'Utilisateur',
        ROLE_COACH: 'Coach',
        ROLE_ADMIN: 'Admin',
        ROLE_SUPER_ADMIN: 'Super admin'
    } %}

    <table class="table">
        <tbody>
            <tr>
                <th>Prénom</th>
                <td>{{ app_user.firstname }}</td>
            </tr>

            <tr>
                <th>Nom</th>
                <td>{{ app_user.lastname }}</td>
            </tr>

            <tr>
                <th>Nom complet</th>
                <td>{{ app_user.fullName }}</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>{{ app_user.email }}</td>
            </tr>

            <tr>
                <th>Rôles</th>
                <td>
                    {% for role in app_user.roles %}
                        {{ roleLabels[role]|default(role) }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </td>
            </tr>

            <tr>
                <th>Club</th>
                <td>{{ app_user.club ? app_user.club.name : 'Aucun club' }}</td>
            </tr>

            <tr>
                <th>Équipes encadrées</th>
                <td>
                    {% if app_user.coachedTeams|length > 0 %}
                        <ul>
                            {% for team in app_user.coachedTeams %}
                                <li>
                                    <a href="{{ path('app_team_show', { id: team.id }) }}">
                                        {{ team.name }}
                                    </a>

                                    {% if team.category %}
                                        — {{ team.category.name }}
                                    {% endif %}

                                    {% if team.season %}
                                        — {{ team.season.name }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        Aucune équipe encadrée
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_index') }}">Retour à la liste</a>
    <a href="{{ path('app_user_edit', { id: app_user.id }) }}">Modifier</a>

    {% if app.user and app.user.id == app_user.id %}
        <div class="alert alert-warning">
            <p>
                Vous ne pouvez pas supprimer votre propre compte.
            </p>
        </div>
    {% else %}
        {{ include('app_user/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}