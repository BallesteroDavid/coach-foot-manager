{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
    <h1>Modifier l'utilisateur</h1>

    {{ include('app_user/_form.html.twig', {
        button_label: 'Mettre à jour l’utilisateur'
    }) }}

    <a href="{{ path('app_user_index') }}">Retour à la liste</a>
    <a href="{{ path('app_user_show', { id: app_user.id }) }}">Retour au détail</a>

    {% if app.user and app.user.id == app_user.id %}
        <div class="alert alert-warning">
            <p>
                Vous ne pouvez pas supprimer votre propre compte.
            </p>
        </div>
    {% else %}
        {{ include('app_user/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}