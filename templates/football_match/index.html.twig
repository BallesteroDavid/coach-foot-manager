{% extends 'base.html.twig' %}

{% block title %}Liste des matchs{% endblock %}

{% block body %}
    <h1>Liste des matchs</h1>

    <a href="{{ path('app_football_match_new') }}">Créer un match</a>

    {% set locationLabels = {
        home: 'Domicile',
        away: 'Extérieur',
        neutral: 'Terrain neutre'
    } %}

    {% set statusLabels = {
        planned: 'Planifié',
        in_progress: 'En cours',
        finished: 'Terminé',
        cancelled: 'Annulé'
    } %}

    {% set matchTypeLabels = {
        simple: 'Match simple',
        aller: 'Match aller',
        retour: 'Match retour'
    } %}

    <table class="table">
        <thead>
            <tr>
                <th>Équipe</th>
                <th>Date</th>
                <th>Heure</th>
                <th>Adversaire</th>
                <th>Lieu</th>
                <th>Type de lieu</th>
                <th>Type de match</th>
                <th>Compétition</th>
                <th>Score</th>
                <th>Résultat</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for football_match in football_matches %}
                <tr>
                    <td>{{ football_match.team.name }}</td>

                    <td>
                        {{ football_match.matchDate ? football_match.matchDate|date('d/m/Y') : '-' }}
                    </td>

                    <td>
                        {{ football_match.startTime ? football_match.startTime|date('H:i') : '-' }}
                    </td>

                    <td>{{ football_match.opponent }}</td>

                    <td>{{ football_match.location }}</td>

                    <td>
                        {{ locationLabels[football_match.locationType]|default(football_match.locationType) }}
                    </td>

                    <td>
                        {{ matchTypeLabels[football_match.matchType]|default(football_match.matchType) }}

                        {% if football_match.matchType == 'retour' and football_match.firstMatch %}
                            <br>
                            <small>
                                Retour du match du {{ football_match.firstMatch.matchDate|date('d/m/Y') }}
                            </small>
                        {% endif %}

                        {% if football_match.matchType == 'aller' and football_match.returnMatches|length > 0 %}
                            <br>
                            <small>
                                {{ football_match.returnMatches|length }} match retour associé
                            </small>
                        {% endif %}
                    </td>

                    <td>
                        {{ football_match.competition ?: '-' }}
                    </td>

                    <td>
                        {{ football_match.scoreLabel }}
                    </td>

                    <td>
                        {{ football_match.resultLabel }}
                    </td>

                    <td>
                        {{ statusLabels[football_match.status]|default(football_match.status) }}
                    </td>

                    <td>
                        <a href="{{ path('app_football_match_show', { id: football_match.id }) }}">Voir</a>
                        <a href="{{ path('app_football_match_edit', { id: football_match.id }) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="12">Aucun match trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}