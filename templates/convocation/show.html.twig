{% extends 'base.html.twig' %}

{% block title %}Détail de la convocation{% endblock %}

{% block body %}
    <div class="page-container">

        <div class="page-header">
            <div>
                <h1 class="page-title">Détail de la convocation</h1>

                <p class="page-subtitle">
                    Informations du joueur convoqué et du match associé.
                </p>
            </div>

            <div class="top-actions">
                <a href="{{ path('app_convocation_index') }}" class="btn btn-secondary">
                    Retour à la liste
                </a>

                {% if convocation.footballMatch %}
                    <a href="{{ path('app_football_match_show', { id: convocation.footballMatch.id }) }}" class="btn btn-secondary">
                        Retour au match
                    </a>
                {% endif %}

                {% if is_granted('ROLE_COACH') %}
                    <a href="{{ path('app_convocation_edit', { id: convocation.id }) }}" class="btn btn-primary">
                        Modifier
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Informations de la convocation</h2>

            <div class="table-wrapper">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>Match</th>
                            <td>
                                {% if convocation.footballMatch %}
                                    <strong>
                                        {{ convocation.footballMatch.matchDate ? convocation.footballMatch.matchDate|date('d/m/Y') : '-' }}
                                    </strong>
                                    —
                                    {{ convocation.footballMatch.team ? convocation.footballMatch.team.name : 'Équipe inconnue' }}
                                    vs
                                    {{ convocation.footballMatch.opponent ?: 'Adversaire non renseigné' }}
                                {% else %}
                                    <span class="badge badge-muted">Match inconnu</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Joueur</th>
                            <td>
                                {% if convocation.player %}
                                    <a href="{{ path('app_player_show', { id: convocation.player.id }) }}">
                                        <strong>{{ convocation.player.fullName }}</strong>
                                    </a>
                                {% else %}
                                    <span class="badge badge-muted">Joueur inconnu</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Statut</th>
                            <td>
                                <span class="badge">
                                    {{ convocation.statusLabel }}
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Commentaire</th>
                            <td>
                                {{ convocation.comment ?: 'Aucun commentaire' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Créée par</th>
                            <td>
                                {{ convocation.createdBy ? convocation.createdBy.fullName : 'Non renseigné' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Créée le</th>
                            <td>
                                {{ convocation.createdAt ? convocation.createdAt|date('d/m/Y H:i') : '-' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Modifiée le</th>
                            <td>
                                {{ convocation.updatedAt ? convocation.updatedAt|date('d/m/Y H:i') : '-' }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {% if is_granted('ROLE_COACH') %}
            <section class="dashboard-section">
                <div class="section-title">
                    <h2>Suppression</h2>
                    <p>Supprimer cette convocation si elle n’est plus nécessaire.</p>
                </div>

                {{ include('convocation/_delete_form.html.twig') }}
            </section>
        {% endif %}

    </div>
{% endblock %}