<form method="post" action="{{ path('app_convocation_delete', { id: convocation.id }) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette convocation ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ convocation.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>