{% extends 'base.html.twig' %}

{% block title %}Détail du club{% endblock %}

{% block body %}
    <h1>Détail du club</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ club.name }}</td>
            </tr>

            <tr>
                <th>Ville</th>
                <td>{{ club.city ?: 'Non renseignée' }}</td>
            </tr>

            <tr>
                <th>Adresse</th>
                <td>{{ club.address ?: 'Non renseignée' }}</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>{{ club.email ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Téléphone</th>
                <td>{{ club.phone ?: 'Non renseigné' }}</td>
            </tr>

            <tr>
                <th>Utilisateurs</th>
                <td>{{ club.appUsersCount }}</td>
            </tr>

            <tr>
                <th>Équipes</th>
                <td>{{ club.teamsCount }}</td>
            </tr>

            <tr>
                <th>Catégories</th>
                <td>{{ club.categoriesCount }}</td>
            </tr>

            <tr>
                <th>Saisons</th>
                <td>{{ club.seasonsCount }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_club_index') }}">Retour à la liste</a>
    <a href="{{ path('app_club_edit', { id: club.id }) }}">Modifier</a>

    {% if club.appUsersCount > 0 or club.teamsCount > 0 or club.categoriesCount > 0 or club.seasonsCount > 0 %}
        <div class="alert alert-warning">
            <p>
                Ce club possède déjà des utilisateurs, équipes, catégories ou saisons associés.
                Il ne peut pas être supprimé directement.
            </p>

            <p>
                Retire d'abord les éléments liés avant de supprimer ce club.
            </p>
        </div>
    {% else %}
        {{ include('club/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}