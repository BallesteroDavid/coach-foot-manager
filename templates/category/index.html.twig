{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="page-container">

        <div class="page-header">
            <div>
                <h1 class="page-title">Catégories</h1>
                <p class="page-subtitle">
                    Gestion des catégories d’âge du club.
                </p>
            </div>

            <div class="top-actions">
                <a href="{{ path('app_category_new') }}" class="btn btn-primary">
                    Créer une catégorie
                </a>
            </div>
        </div>

        {% if categories is empty %}
            <div class="empty-state">
                <strong>Aucune catégorie enregistrée.</strong>
                <p>
                    Crée une première catégorie pour organiser les équipes du club.
                </p>
            </div>
        {% else %}
            <div class="card">
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Club</th>
                                <th>Âge minimum</th>
                                <th>Âge maximum</th>
                                <th>Équipes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for category in categories %}
                                <tr>
                                    <td>
                                        <strong>{{ category.name }}</strong>
                                    </td>

                                    <td>
                                        {% if category.club %}
                                            {{ category.club.name }}
                                        {% else %}
                                            <span class="badge badge-muted">Aucun club</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if category.ageMin is not null %}
                                            <span class="badge">{{ category.ageMin }} ans</span>
                                        {% else %}
                                            <span class="badge badge-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if category.ageMax is not null %}
                                            <span class="badge">{{ category.ageMax }} ans</span>
                                        {% else %}
                                            <span class="badge badge-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        <span class="badge badge-success">
                                            {{ category.teamsCount }} équipe{{ category.teamsCount > 1 ? 's' : '' }}
                                        </span>
                                    </td>

                                    <td>
                                        <div class="actions">
                                            <a href="{{ path('app_category_show', { id: category.id }) }}" class="btn btn-secondary">
                                                Voir
                                            </a>

                                            <a href="{{ path('app_category_edit', { id: category.id }) }}" class="btn btn-primary">
                                                Modifier
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}