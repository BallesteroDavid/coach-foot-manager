{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    <div class="page-container">

        <div class="page-header">
            <div>
                <h1 class="page-title">{{ category.name }}</h1>
                <p class="page-subtitle">
                    Détail de la catégorie et des équipes associées.
                </p>
            </div>

            <div class="top-actions">
                <a href="{{ path('app_category_index') }}" class="btn btn-secondary">
                    Retour à la liste
                </a>

                <a href="{{ path('app_category_edit', { id: category.id }) }}" class="btn btn-primary">
                    Modifier
                </a>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Informations de la catégorie</h2>

            <div class="table-wrapper">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>Nom</th>
                            <td>
                                <strong>{{ category.name }}</strong>
                            </td>
                        </tr>

                        <tr>
                            <th>Club</th>
                            <td>
                                {% if category.club %}
                                    {{ category.club.name }}
                                {% else %}
                                    <span class="badge badge-muted">Aucun club</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Âge minimum</th>
                            <td>
                                {% if category.ageMin is not null %}
                                    <span class="badge">{{ category.ageMin }} ans</span>
                                {% else %}
                                    <span class="badge badge-muted">Non renseigné</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Âge maximum</th>
                            <td>
                                {% if category.ageMax is not null %}
                                    <span class="badge">{{ category.ageMax }} ans</span>
                                {% else %}
                                    <span class="badge badge-muted">Non renseigné</span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Nombre d’équipes</th>
                            <td>
                                <span class="badge badge-success">
                                    {{ category.teamsCount }} équipe{{ category.teamsCount > 1 ? 's' : '' }}
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Créée le</th>
                            <td>
                                {{ category.createdAt ? category.createdAt|date('d/m/Y H:i') : '-' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Modifiée le</th>
                            <td>
                                {{ category.updatedAt ? category.updatedAt|date('d/m/Y H:i') : '-' }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {% if category.teams|length > 0 %}
            <section class="dashboard-section">
                <div class="section-title">
                    <h2>Équipes associées</h2>
                    <p>Les équipes rattachées à cette catégorie.</p>
                </div>

                <div class="card">
                    <div class="table-wrapper">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Équipe</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for team in category.teams %}
                                    <tr>
                                        <td>
                                            <strong>{{ team.name }}</strong>
                                        </td>

                                        <td>
                                            <a href="{{ path('app_team_show', { id: team.id }) }}" class="btn btn-secondary">
                                                Voir
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        {% endif %}

        <section class="dashboard-section">
            <div class="section-title">
                <h2>Suppression</h2>
                <p>Suppression possible uniquement si aucune équipe n’est associée.</p>
            </div>

            {% if category.teamsCount > 0 %}
                <div class="alert alert-warning">
                    <p>
                        Cette catégorie possède déjà une ou plusieurs équipes associées.
                        Elle ne peut pas être supprimée directement.
                    </p>

                    <p>
                        Retire d'abord les équipes de cette catégorie avant de la supprimer.
                    </p>
                </div>
            {% else %}
                {{ include('category/_delete_form.html.twig') }}
            {% endif %}
        </section>

    </div>
{% endblock %}